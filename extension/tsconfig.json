{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "outDir": "build/ts",
    "rootDir": ".",
    "skipLibCheck": true,
    "types": []
  },
  "include": [
    "shared/src/**/*.ts",
    "chromium/src/**/*.ts",
    "firefox/src/**/*.ts"
  ]
}
